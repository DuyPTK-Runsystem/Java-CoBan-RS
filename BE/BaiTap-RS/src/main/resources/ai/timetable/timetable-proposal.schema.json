{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TimetableProposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "PROPOSED",
        "NEEDS_INPUT",
        "NO_SOLUTION_FOUND"
      ]
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assignmentId": {
            "type": "integer",
            "minimum": 1
          },
          "periodId": {
            "type": "integer",
            "minimum": 1
          },
          "functionalRoomId": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validTo": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "assignmentId",
          "periodId",
          "functionalRoomId",
          "validFrom",
          "validTo"
        ]
      }
    },
    "unresolvedConstraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "field",
          "message"
        ]
      }
    },
    "explanation": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "status",
    "snapshotId",
    "entries",
    "unresolvedConstraints",
    "explanation"
  ]
}
