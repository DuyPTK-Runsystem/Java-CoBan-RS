# Local Docker runtime only. Do not commit docker/.env.
MYSQL_ROOT_PASSWORD=change-this-before-running
API_HOST_PORT=8081

# Optional local image name. This is not a registry publishing instruction.
API_IMAGE_NAME=java-coban-api:local

# Optional OpenAI-compatible provider (for example, 9Router).
# Use the exact API base URL and key shown by your provider account.
# For local Compose, copy this file to docker/.env and fill in the values.
SPRING_AI_OPENAI_BASE_URL=https://replace-with-provider-api-base-url
SPRING_AI_OPENAI_API_KEY=replace-with-provider-api-key
SPRING_AI_OPENAI_CHAT_MODEL=replace-with-9router-model-id

# Leave disabled until provider/model access is configured and validated.
APP_AI_TIMETABLE_ENABLED=false
# All five limits must be positive to enable the timetable agent.
APP_AI_TIMETABLE_MAX_CLASS_COUNT=10
APP_AI_TIMETABLE_MAX_CONTEXT_CHARACTERS=30000
APP_AI_TIMETABLE_MAX_REQUEST_CHARACTERS=4000
APP_AI_TIMETABLE_MAX_PREFERENCES_CHARACTERS=4000
APP_AI_TIMETABLE_MAX_PROPOSAL_ENTRIES=500
